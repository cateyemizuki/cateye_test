{
  "manifest_version": 2,
  "id": "github.cateye.cateye-suite",
  "version": "0.4.0",
  "name": "猫眼生活套件（骨架版）",
  "description": "整合插件：① 自主规划——LLM 按人设多轮生成每日作息日程（SQLite + 质量评分 + 语义校验），当前活动注入 planner/replyer，活动切换/约定到期主动开口，/plan 命令与日程图片；② 虚拟恋人——好感度 + 巡检主动聊天（早安/晚安/想念/节点分享，概率+预算+静默时段），屏幕感知旁白注入，恋人电脑联动；③ QQ 空间——按日程发说说（动作层+Web CGI 双通道）、自动回复评论（含楼中楼）、点赞。/plan、/mai_*、/life 三组命令。",
  "author": {
    "name": "cateye",
    "url": "https://github.com/cateyemizuki"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/cateyemizuki/cateye_test",
    "homepage": "https://github.com/cateyemizuki/cateye_test",
    "documentation": "https://github.com/cateyemizuki/cateye_test/blob/main/README.md",
    "issues": "https://github.com/cateyemizuki/cateye_test/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.6.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "httpx",
      "version_spec": ">=0.24.0"
    },
    {
      "type": "python_package",
      "name": "Pillow",
      "version_spec": ">=9.0.0"
    }
  ],
  "plugin_type": "tool",
  "display": {
    "icon": {
      "type": "lucide",
      "value": "heart",
      "fallback": "calendar-heart"
    }
  },
  "capabilities": [
    "send.text",
    "send.image",
    "send.forward",
    "config.get",
    "llm.generate",
    "chat.get_all_streams",
    "chat.get_stream_by_user_id",
    "chat.get_private_streams",
    "chat.get_stream_by_group_id",
    "message.get_by_time_in_chat",
    "maisaka.proactive.trigger",
    "maisaka.context.append",
    "frequency.set_adjust",
    "knowledge.search",
    "api.call",
    "database.get"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN",
      "en-US"
    ]
  }
}
